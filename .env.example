# Copy to .env.local. Do not commit real keys.
# These values are read on the server at request time.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional server-only aliases. Use them when the host injects env at runtime.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Optional. This app does not read the service role key.
# SUPABASE_SERVICE_ROLE_KEY=
