# Copy to .env.local. Do not commit real keys.
# These values are read on the server at request time.

NEXT_PUBLIC_SUPABASE_URL=https://mrxvheaqlrengivuxrkw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_A1j0U-Imv4K_AvaJe6jlcg_Ti-U-7MZ

# Optional server-only aliases. Use them when the host injects env at runtime.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Optional. This app does not read the service role key.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional browser check, in bytes. Set it to the project's Global file size limit
# from Supabase Storage Settings. Leave it empty when that number is unknown.
# A bucket file_size_limit is enforced too, and the smaller value wins.
# An empty bucket limit is not the same as having no limit.
# MAX_UPLOAD_BYTES=
